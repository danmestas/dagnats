# Leaf link allow-list for the eu region's leaf listener (ADR-031). The
# migration runbook loads this file on every eu node, and
# server/region_rehearsal_test.go loads it too, so the rehearsed list is
# the deployed list. Single quotes keep a shell from expanding $JS and $SRV.
DAGNATS_LEAF_LISTEN_ALLOW='$JS.eu.API.>,$JS.us.API.>,$JS.ACK.>,$JS.FC.>,_INBOX.>,agents.>,a2a.reply.>,$SRV.PING.agents,$SRV.PING.agents.*,$SRV.INFO.agents,$SRV.INFO.agents.*,$SRV.STATS.agents,$SRV.STATS.agents.*'
