{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danmestas/dagnats/blob/main/docs/workflow-schema.json",
  "title": "DagNats Workflow Definition",
  "description": "JSON Schema for DagNats workflow definitions",
  "type": "object",
  "required": [
    "name",
    "version",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference (allows $schema in workflow files)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique workflow identifier"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Schema version for evolution"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "At least one step required",
      "items": {
        "$ref": "#/$defs/StepDef"
      }
    },
    "default_retry": {
      "$ref": "#/$defs/RetryPolicy",
      "description": "Fallback retry policy for all steps"
    },
    "concurrency": {
      "$ref": "#/$defs/ConcurrencyLimit",
      "description": "Workflow-level parallelism limits"
    },
    "timeout": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
      "description": "Overall workflow deadline (Go duration string or nanoseconds)"
    },
    "input_schema": {
      "description": "JSON Schema for workflow input validation"
    },
    "output_schema": {
      "description": "JSON Schema for workflow output validation"
    },
    "triggers": {
      "type": "array",
      "description": "Optional triggers registered alongside the workflow. workflow_id is auto-filled from the workflow name when omitted.",
      "items": {
        "$ref": "#/$defs/TriggerDef"
      }
    },
    "aux_steps": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Steps whose outcome does not decide the run's status"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Input path whose value dedups run starts"
    },
    "sticky": {
      "type": "string",
      "enum": [
        "",
        "soft",
        "hard"
      ],
      "description": "Worker affinity strategy"
    },
    "priority": {
      "type": "object",
      "description": "Input-driven dispatch priority (key, rules, default_offset)"
    },
    "cancel_on": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["event", "match"],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "match": {
            "type": "object",
            "required": ["left", "op", "right"],
            "properties": {
              "left": { "type": "string", "minLength": 1 },
              "op": { "type": "string", "enum": ["eq"] },
              "right": { "type": "string", "pattern": "^input\\." }
            }
          },
          "timeout": {
            "type": ["string", "integer"],
            "description": "Duration string such as \"1h\", or nanoseconds"
          }
        }
      },
      "description": "Events that cancel the run. match.right is a path into the run input (input.<field>)."
    },
    "singleton": {
      "type": "object",
      "description": "One run at a time: mode (skip or cancel), optional key"
    }
  },
  "$defs": {
    "StepDef": {
      "type": "object",
      "required": [
        "id",
        "task"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique step identifier within the workflow"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "description": "Task name workers subscribe to"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step IDs that must complete before this step"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy retry count (prefer retry policy)"
        },
        "timeout": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
          "description": "Per-step execution deadline (Go duration string or nanoseconds)"
        },
        "type": {
          "type": "string",
          "enum": [
            "normal",
            "agent_loop",
            "sub_workflow",
            "agent",
            "map",
            "sleep",
            "wait_for_event",
            "approval",
            "planner",
            "respond"
          ],
          "description": "Execution semantics"
        },
        "config": {
          "type": "object",
          "description": "Type-specific settings: AgentLoopConfig for agent_loop, sleep/map/approval/respond/wait_for_event/planner/sub_workflow settings for those types"
        },
        "skip_if": {
          "$ref": "#/$defs/ParentCond",
          "description": "Conditional skip based on parent output"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Arbitrary key-value pairs"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "description": "Structured retry policy (overrides retries)"
        },
        "worker_group": {
          "type": "string",
          "description": "Routes to a specific worker pool"
        },
        "on_failure": {
          "type": "string",
          "description": "Step ID to run on failure"
        },
        "compensate": {
          "type": "string",
          "description": "Step ID for saga compensation"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Runtime capabilities the handler requires (e.g. 'control-plane'). Gates capability handles on TaskContext."
        },
        "rate_limit": {
          "type": "object",
          "description": "limit dispatches per period for this step's task"
        },
        "keyed_rate_limit": {
          "type": "object",
          "description": "Rate limit per input key (key, limit, period, units)"
        },
        "max_task_concurrency": {
          "type": "integer",
          "minimum": 0,
          "description": "Max in-flight tasks of this step's task type; 0 = unlimited"
        },
        "singleton": {
          "type": "boolean",
          "description": "Only one instance of this step runs at a time"
        }
      }
    },
    "TriggerDef": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "Trigger declaration: exactly one of cron, subject, webhook, or http must be present.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique trigger identifier"
        },
        "workflow_id": {
          "type": "string",
          "description": "Auto-filled from the workflow's name when omitted"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the trigger is active"
        },
        "cron": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expression": {
              "type": "string",
              "description": "5-field cron expression: minute hour day-of-month month day-of-week. Sub-minute scheduling is not supported (the trigger engine has minute-precision dedup). 6-field forms with a leading seconds field are rejected."
            },
            "timezone": {
              "type": "string"
            },
            "backfill": {
              "type": "boolean"
            }
          },
          "required": [
            "expression"
          ]
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "subject"
          ]
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "description": "Synchronous HTTP trigger per ADR-013. Pairs with a respond step in the DAG.",
          "properties": {
            "path": {
              "type": "string",
              "description": "Exact-match URL path (must start with /). No wildcards in v1."
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "Hard cap on the synchronous wait for the respond step. Default 30000."
            },
            "max_body_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Request body size cap. Default 1 MiB."
            },
            "secret": {
              "type": "string",
              "minLength": 16,
              "description": "Optional HMAC secret. Mirrors WebhookConfig.Secret."
            },
            "idempotency_header": {
              "type": "string",
              "description": "Optional header name (e.g. Idempotency-Key) whose value replays the prior run's response from KV."
            }
          },
          "required": [
            "path",
            "method",
            "timeout_ms",
            "max_body_bytes"
          ]
        },
        "debounce": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "period": {
              "type": [
                "string",
                "number"
              ]
            },
            "timeout": {
              "type": [
                "string",
                "number"
              ]
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "required": [
        "max_attempts",
        "strategy",
        "initial_delay"
      ],
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Total retry attempts; 0 means no retries"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ],
          "description": "Backoff algorithm"
        },
        "initial_delay": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
          "description": "Base delay between attempts (Go duration string or nanoseconds)"
        },
        "max_delay": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
          "description": "Delay cap; 0 means uncapped (Go duration string or nanoseconds)"
        },
        "multiplier": {
          "type": "number",
          "description": "Used by exponential strategy only"
        }
      }
    },
    "AgentLoopConfig": {
      "type": "object",
      "required": [
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Upper bound on loop cycles; must be > 0"
        },
        "max_duration": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
          "description": "Wall-clock limit (Go duration string or nanoseconds)"
        },
        "loop_delay": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)+$",
          "description": "Pause between iterations (Go duration string or nanoseconds)"
        },
        "budget_warn_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Advisory iteration to warn the model"
        },
        "budget_force_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Advisory iteration to force a wrap-up"
        }
      }
    },
    "ConcurrencyLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runs": {
          "type": "integer",
          "minimum": 0,
          "description": "Max parallel runs of this workflow"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Max parallel steps within a run"
        }
      }
    },
    "ParentCond": {
      "type": "object",
      "required": [
        "step_id",
        "field",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "description": "Parent step to check (must be in depends_on)"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level key in parent's output JSON"
        },
        "op": {
          "type": "string",
          "enum": [
            "==",
            "!=",
            "<",
            ">",
            "<=",
            ">="
          ],
          "description": "Comparison operator"
        },
        "value": {
          "description": "Value to compare against"
        }
      }
    }
  }
}
